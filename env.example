# ============================================================
# GOEN 環境変数テンプレート
# このファイルを .env にコピーして値を入力してください
# ============================================================

# LINE Developers Console で取得
LINE_CHANNEL_SECRET=ここに貼り付け
LINE_CHANNEL_ACCESS_TOKEN=ここに貼り付け

# Supabase ダッシュボード > Settings > API で取得
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=ここに貼り付け

# 運営者のLINE User ID（通知を受け取るアカウント）
ADMIN_LINE_USER_ID=ここに貼り付け

# サーバーポート（Renderなどのホスティングは自動設定）
PORT=3000
